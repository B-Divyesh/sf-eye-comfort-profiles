{
  "name": "eye-comfort-profiles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local, repeatable per-site reading geometry for Chromium browsers.",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build",
    "build:site": "vite build --config vite.site.config.ts",
    "package:extension": "wxt zip && node scripts/stage-extension.mjs",
    "build": "npm run clean && npm run build:extension && npm run build:site && npm run package:extension",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/model.test.ts tests/release-config.test.ts",
    "test:release": "npm run build && vitest run tests/release-artifact.test.ts",
    "test:watch": "vitest",
    "test:a11y": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.326",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
